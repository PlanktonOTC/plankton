# Copy to web/.env.local. None of these are secrets: they are baked into the public site at build time.

# Where the browser sends API calls. Leave unset: '/api' is forwarded by the server (the dev server below, or
# web/server.mjs in production via API_ORIGIN), so the browser never calls the API directly.
# VITE_API_URL=/api

# Development only: where the dev server forwards '/api'. The local API from scripts/fork-stack.ps1 listens on 8787.
# VITE_API_PROXY=http://127.0.0.1:8787

# Chain the wallet must be on, and an RPC the browser reads receipts from. Defaults are Robinhood Chain mainnet.
# For the local fork keep the chain id (4663) and point the RPC at anvil:
# VITE_CHAIN_ID=4663
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
