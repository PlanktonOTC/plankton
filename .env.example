# Hosted Postgres (Neon/Supabase). Include ?sslmode=require. Only api and indexer need it.
DATABASE_URL=

# Comma-separated, first is preferred. Put a paid provider first; the public RPC is rate-limited and not for production.
RPC_URLS=https://rpc.mainnet.chain.robinhood.com

RH_API_BASE=https://api.robinhood.com/rhj
NASDAQ_HALTS_URL=https://www.nasdaqtrader.com/rss.aspx?feed=tradehalts

# Stock Token mint/burn window is Mon 02:00 to Sat 02:00 in this zone (follows CET/CEST).
STOCK_TOKEN_WINDOW_TZ=Europe/Berlin

MARK_PORT=8788
MARK_SERVICE_URL=http://127.0.0.1:8788
API_PORT=8787
LOG_LEVEL=info

# --- signers (one process per key; the API and mark service hold NO signing key) ---
# SIGNER_ROLE=quote on the quote-signer hosts, SIGNER_ROLE=mark on the two mark-signer hosts.
SIGNER_ROLE=
SIGNER_PRIVATE_KEY=
SIGNER_PORT=8790
# Production requires mTLS (SIGNER_TLS_CERT/KEY/CA) unless SIGNER_HOST=127.0.0.1 keeps the signer private to its host.
SIGNER_HOST=
# At least 16 characters. Shared by the API, publisher and signers.
SIGNER_AUTH_TOKEN=
QUOTE_SIGNER_URLS=
MARK_SIGNER_URLS=

# --- service wallets (each funded with a little gas ETH, none shared) ---
PUBLISHER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
API_URL=http://127.0.0.1:8787
KEEPER_PORT=8791

# --- public API protection ---
# Browser origins allowed to call the API, comma-separated (https://app.example.com). Empty means none in production.
CORS_ORIGINS=
# Requests per minute per client address (quote and order routes get a third of this).
API_RATE_LIMIT_PER_MIN=240
# true only when the API runs behind a proxy you control that sets x-real-ip / x-forwarded-for.
TRUST_PROXY=false
# At least 16 characters. Give the SAME value to the API and the keeper so the keeper's own calls skip the rate limit.
INTERNAL_API_TOKEN=
# At least 32 characters. Give the SAME value to the API and the website's server (web/server.mjs), which makes every
# /api call for the browser and names each visitor so the rate limit applies per visitor.
WEB_PROXY_TOKEN=

# --- listing rule ---
# Leave unset: enforce in production, warn elsewhere. Production refuses to start with anything but enforce.
ELIGIBILITY_MODE=

# --- several services on one host (scripts/run-roles.ts, `bun run start:roles`) ---
# For hosts with few always-on instances (Render free). The first role gets PORT; the rest talk over 127.0.0.1.
# Keys are read per role: PUBLISHER_PRIVATE_KEY, KEEPER_PRIVATE_KEY, QUOTE_SIGNER_1_PRIVATE_KEY, MARK_SIGNER_<n>_PRIVATE_KEY.
# ROLES=api,mark,signer-quote,signer-mark-1,signer-mark-2,signer-mark-3,keeper,indexer   (add web first to serve the site too)
# MIGRATE_ON_START=true
